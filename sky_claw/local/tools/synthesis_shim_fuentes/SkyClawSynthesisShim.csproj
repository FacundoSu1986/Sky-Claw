<!--
  Shim de Sky-Claw para patchers de Synthesis (ADR 0019 §2.1/§2.4). Lo compila la Fase 1, FUERA
  de USVFS, con `dotnet build` y los argumentos de `synthesis_prebuild.argumentos_dotnet_build_patcher`.

  - CETCompat=false: bajo usvfs 0.5.6.1 un apphost CET-compatible cae con 0xC0000005 (evidencia de
    rig 2026-11-22). El override de línea de comandos también lo apaga; acá queda declarado para
    que un build manual no lo encienda por el default del SDK .NET 9+.
  - Sin PackageReference: el restore no necesita red (solo los packs del SDK).
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CETCompat>false</CETCompat>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>
</Project>
